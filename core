local function normalize(id)return tostring(id)("rbxassetid://", "")("%s+", "")end

local function playAbilitySound(info)

	local soundId = info.Sound

	local sound = Instance.new("Sound")
	sound.SoundId = "rbxassetid://" .. normalize(soundId)
	sound.Volume = 3
	sound.Parent = SoundService

	if info.DelayTime then
		task.wait(info.DelayTime)
	end

	sound:Play()

	sound.Ended:Connect(function()
		task.wait(0.2)
		sound:Destroy()
	end)

end

local Cooldowns = {}

for _, child in ipairs(ToolBar:GetDescendants()) do
	if child:IsA("ImageLabel") then
		child:GetPropertyChangedSignal("ImageTransparency"):Connect(function()
			task.wait(0.01)

			for ability, info in pairs(Data) do
				if normalize(child.Image) == normalize(info.Icon) then

					if child.ImageTransparency == 0 then						
						Cooldowns[ability] = false
						print(ability, "cooldown reset")

					elseif child.ImageTransparency > 0 then
						if not Cooldowns[ability] then

							print(ability, "cooldown started")
							playAbilitySound(info)
							Cooldowns[ability] = true
						else
							print(ability, "already on cooldown")
						end
					end

					break
				end
			end
		end)
	end
end
